// Manako Node — Prisma schema (PostgreSQL)
//
// Kompatibel dengan struktur tabel legacy `manako.sql` (MariaDB),
// diporting ke PostgreSQL. Nama tabel & kolom dipertahankan pakai
// @@map/@map supaya query raw legacy tetap bisa jalan sementara migrasi.
//
// Tambahan dari legacy:
//   - model RefreshToken (auth)
//   - FK eksplisit projects.pic_vendor_id → users
//   - Semua enum berupa PostgreSQL enum

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ────────────────────────────────────────────────────────────────
// Enums
// ────────────────────────────────────────────────────────────────

enum UserRole {
  admin
  inspector
  viewer
  vendor_contact
}

enum ProjectStatus {
  inisiasi
  running
  completed
  closed
  cancelled
}

enum ContractType {
  new
  renewal
}

enum Classification {
  rutin
  non_rutin
}

enum TerminType {
  monthly
  quarterly
  percentage
  oneoff
}

enum DocumentStatus {
  pending
  uploaded
  verified
  rejected
}

enum DocTypeStage {
  inisiasi
  pelaksanaan
}

enum NotificationChannel {
  email
  whatsapp
  inapp
}

enum NotificationStatus {
  sent
  failed
}

enum RequirementScope {
  init
  termin
}

// ────────────────────────────────────────────────────────────────
// Users
// ────────────────────────────────────────────────────────────────

model User {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(150)
  email         String?   @unique @db.VarChar(150)
  phone         String?   @db.VarChar(30)
  role          UserRole  @default(viewer)
  password_hash String?   @db.VarChar(255)
  deleted_at    DateTime? @db.Timestamptz(6)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime? @updatedAt @db.Timestamptz(6)

  projects_pic_ikt    Project[]        @relation("PicIkt")
  projects_pic_vendor Project[]        @relation("PicVendor")
  documents_uploaded  Document[]       @relation("UploadedBy")
  documents_verified  Document[]       @relation("VerifiedBy")
  notifications       Notification[]
  audit_logs          AuditLog[]
  refresh_tokens      RefreshToken[]

  @@map("users")
}

// ────────────────────────────────────────────────────────────────
// Vendors
// ────────────────────────────────────────────────────────────────

model Vendor {
  id            Int      @id @default(autoincrement())
  name          String   @db.VarChar(200)
  contact_name  String?  @db.VarChar(150)
  contact_phone String?  @db.VarChar(30)
  contact_email String?  @db.VarChar(150)
  npwp          String?  @db.VarChar(50)
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  projects Project[]

  @@map("vendors")
}

// ────────────────────────────────────────────────────────────────
// Projects
// ────────────────────────────────────────────────────────────────

model Project {
  id                Int             @id @default(autoincrement())
  code              String?         @unique @db.VarChar(50)
  name              String          @db.VarChar(255)
  vendor_id         Int?
  pic_ikt_id        Int?
  pic_vendor_id     Int?
  value             Decimal         @default(0) @db.Decimal(20, 2)
  start_date        DateTime?       @db.Date
  end_date          DateTime?       @db.Date
  description       String?         @db.Text
  contract_file     String?         @db.VarChar(255)
  status            ProjectStatus   @default(inisiasi)
  contract_type     ContractType    @default(new)
  parent_project_id Int?
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  updated_at        DateTime?       @updatedAt @db.Timestamptz(6)
  progress_percent  Decimal         @default(0) @db.Decimal(5, 2)
  classification    Classification? @default(rutin)
  no_kontrak        String?         @db.VarChar(255)

  vendor         Vendor?   @relation(fields: [vendor_id], references: [id], onDelete: SetNull)
  pic_ikt        User?     @relation("PicIkt", fields: [pic_ikt_id], references: [id], onDelete: SetNull)
  pic_vendor     User?     @relation("PicVendor", fields: [pic_vendor_id], references: [id], onDelete: SetNull)
  parent_project Project?  @relation("Renewal", fields: [parent_project_id], references: [id], onDelete: SetNull)
  children       Project[] @relation("Renewal")

  termins              Termin[]
  documents            Document[]
  initiation_documents InitiationDocument[]
  notifications        Notification[]

  @@index([vendor_id])
  @@index([status])
  @@index([classification])
  @@index([created_at])
  @@map("projects")
}

// ────────────────────────────────────────────────────────────────
// Termins
// ────────────────────────────────────────────────────────────────

model Termin {
  id           Int        @id @default(autoincrement())
  project_id   Int
  name         String?    @db.VarChar(100)
  type         TerminType @default(oneoff)
  period_start DateTime?  @db.Date
  period_end   DateTime?  @db.Date
  percentage   Decimal    @default(0) @db.Decimal(5, 2)
  amount       Decimal?   @db.Decimal(20, 2)
  due_date     DateTime?  @db.Date
  order_index  Int        @default(0)
  created_at   DateTime   @default(now()) @db.Timestamptz(6)

  project           Project              @relation(fields: [project_id], references: [id], onDelete: Cascade)
  termin_documents  TerminDocument[]
  documents         Document[]
  pr_po_coverage    PrPoTerminCoverage[]
  notifications     Notification[]

  @@index([project_id])
  @@index([due_date])
  @@map("termins")
}

// ────────────────────────────────────────────────────────────────
// Doc Types (catalog)
// ────────────────────────────────────────────────────────────────

model DocType {
  id         Int          @id @default(autoincrement())
  keyname    String?      @unique @db.VarChar(100)
  label      String?      @db.VarChar(200)
  stage      DocTypeStage @default(pelaksanaan)
  required   Boolean      @default(true)
  priority   Int          @default(0)
  created_at DateTime     @default(now()) @db.Timestamptz(6)

  documents     Document[]
  notifications Notification[]

  @@map("doc_types")
}

// ────────────────────────────────────────────────────────────────
// Documents (legacy general — jarang dipakai)
// ────────────────────────────────────────────────────────────────

model Document {
  id          Int             @id @default(autoincrement())
  project_id  Int
  termin_id   Int?
  doc_type_id Int
  file_path   String?         @db.VarChar(500)
  file_name   String?         @db.VarChar(255)
  uploaded_by Int?
  uploaded_at DateTime?       @db.Timestamptz(6)
  verified_by Int?
  verified_at DateTime?       @db.Timestamptz(6)
  status      DocumentStatus? @default(pending)
  note        String?         @db.Text
  created_at  DateTime        @default(now()) @db.Timestamptz(6)

  project  Project @relation(fields: [project_id], references: [id], onDelete: Cascade)
  termin   Termin? @relation(fields: [termin_id], references: [id], onDelete: SetNull)
  doc_type DocType @relation(fields: [doc_type_id], references: [id], onDelete: Restrict)
  uploader User?   @relation("UploadedBy", fields: [uploaded_by], references: [id], onDelete: SetNull)
  verifier User?   @relation("VerifiedBy", fields: [verified_by], references: [id], onDelete: SetNull)

  @@index([project_id])
  @@index([termin_id])
  @@index([doc_type_id])
  @@map("documents")
}

// ────────────────────────────────────────────────────────────────
// Termin Documents (yang paling aktif)
// ────────────────────────────────────────────────────────────────

model TerminDocument {
  id           Int      @id @default(autoincrement())
  termin_id    Int
  doc_type     String   @db.VarChar(64)
  file_path    String   @db.VarChar(255)
  status       Int      @default(0) @db.SmallInt // 0=placeholder, 1=uploaded
  uploaded_at  DateTime @default(now()) @db.Timestamptz(6)
  custom_label String?  @db.VarChar(200)
  code_project String   @db.VarChar(50)

  termin Termin @relation(fields: [termin_id], references: [id], onDelete: Cascade)

  @@unique([termin_id, doc_type])
  @@index([code_project])
  @@map("termin_documents")
}

// ────────────────────────────────────────────────────────────────
// Initiation Documents
// ────────────────────────────────────────────────────────────────

model InitiationDocument {
  id          Int      @id @default(autoincrement())
  project_id  Int
  doc_type    String   @db.VarChar(64) // stored UPPER_SNAKE setelah normalize migration
  file_path   String   @db.VarChar(512)
  uploaded_at DateTime @default(now()) @db.Timestamptz(6)
  no_document String?  @db.VarChar(255)
  doc_name    String?  @db.VarChar(255)
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  project        Project              @relation(fields: [project_id], references: [id], onDelete: Cascade)
  pr_po_coverage PrPoTerminCoverage[]

  @@index([project_id, doc_type])
  @@map("initiation_documents")
}

// ────────────────────────────────────────────────────────────────
// Document Requirements (per-termin overrides)
// ────────────────────────────────────────────────────────────────

model DocumentRequirement {
  id           Int              @id @default(autoincrement())
  scope        RequirementScope
  project_id   Int
  termin_id    Int?
  doc_type     String           @db.VarChar(64) // soft-ref ke doc_types.keyname
  required     Boolean          @default(true)
  label        String?          @db.VarChar(200)
  bypass_check Boolean          @default(false)

  @@unique([scope, project_id, termin_id, doc_type])
  @@index([project_id])
  @@index([termin_id])
  @@map("document_requirements")
}

// ────────────────────────────────────────────────────────────────
// PR/PO ↔ Termin coverage
// ────────────────────────────────────────────────────────────────

model PrPoTerminCoverage {
  id          Int      @id @default(autoincrement())
  init_doc_id Int
  termin_id   Int
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  init_doc InitiationDocument @relation(fields: [init_doc_id], references: [id], onDelete: Cascade)
  termin   Termin             @relation(fields: [termin_id], references: [id], onDelete: Cascade)

  @@unique([init_doc_id, termin_id])
  @@index([termin_id])
  @@map("pr_po_termin_coverage")
}

// ────────────────────────────────────────────────────────────────
// Notifications
// ────────────────────────────────────────────────────────────────

model Notification {
  id          Int                  @id @default(autoincrement())
  project_id  Int?
  termin_id   Int?
  doc_type_id Int?
  sent_to     Int?
  channel     NotificationChannel?
  message     String?              @db.Text
  sent_at     DateTime             @default(now()) @db.Timestamptz(6)
  status      NotificationStatus?  @default(sent)

  project   Project? @relation(fields: [project_id], references: [id], onDelete: SetNull)
  termin    Termin?  @relation(fields: [termin_id], references: [id], onDelete: SetNull)
  doc_type  DocType? @relation(fields: [doc_type_id], references: [id], onDelete: SetNull)
  recipient User?    @relation(fields: [sent_to], references: [id], onDelete: SetNull)

  @@index([sent_to])
  @@map("notifications")
}

// ────────────────────────────────────────────────────────────────
// Audit Logs
// ────────────────────────────────────────────────────────────────

model AuditLog {
  id         Int      @id @default(autoincrement())
  user_id    Int?
  action     String?  @db.VarChar(200)
  meta       Json?
  ip         String?  @db.VarChar(64)
  user_agent String?  @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user User? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([user_id])
  @@index([action])
  @@index([created_at])
  @@map("audit_logs")
}

// ────────────────────────────────────────────────────────────────
// Refresh Tokens (BARU — auth JWT rotation)
// ────────────────────────────────────────────────────────────────

model RefreshToken {
  id         String    @id @default(cuid())
  user_id    Int
  token_hash String    @unique
  expires_at DateTime  @db.Timestamptz(6)
  revoked_at DateTime? @db.Timestamptz(6)
  user_agent String?   @db.VarChar(255)
  ip         String?   @db.VarChar(64)
  created_at DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expires_at])
  @@map("refresh_tokens")
}
