NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# PostgreSQL — pastikan DB manako sudah ada
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/manako?schema=public"

# Redis (BullMQ + rate limit)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_ACCESS_SECRET="ganti-dengan-random-32-char-min"
JWT_REFRESH_SECRET="ganti-dengan-random-32-char-min-refresh"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="30d"

# Uploads
UPLOAD_ROOT="./uploads"
MAX_UPLOAD_MB="25"

# OneDrive mirror (path folder yg disync OneDrive desktop client)
ONEDRIVE_ROOT=""

# CORS
CORS_ORIGIN="http://localhost:3000"

# Pajak
PPN_RATE="0.11"

# Bootstrap admin (dipakai seed.ts)
ADMIN_EMAIL="admin@manako.local"
ADMIN_PASSWORD="admin123"
